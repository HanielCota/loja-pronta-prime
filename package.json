{
  "name": "loja-pronta-prime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:seed-sll-pilot": "bun --env-file=.env.local --bun scripts/importar-aula-piloto.ts",
    "db:seed-sll-welcome": "bun --env-file=.env.local --bun scripts/importar-boas-vindas-sll.ts",
    "db:seed-sll-stage1": "bun --env-file=.env.local --bun scripts/importar-etapa1-sll.ts",
    "db:seed-sll-stage2": "bun --env-file=.env.local --bun scripts/importar-etapa2-sll.ts",
    "db:seed-sll-stage3": "bun --env-file=.env.local --bun scripts/importar-etapa3-sll.ts",
    "db:seed-sll-courses": "bun --env-file=.env.local --bun scripts/importar-cursos-complementares-sll.ts",
    "db:seed-sll-banners": "bun --env-file=.env.local --bun scripts/importar-banners-sll.ts",
    "db:seed-sll-resources": "bun --env-file=.env.local --bun scripts/importar-recursos-sll.ts",
    "auth:schema": "bun x auth@1.7.7 generate --config src/server/auth/auth.ts --output src/server/db/schema/auth.ts -y",
    "dev:aluna": "bun scripts/criar-aluna-teste.ts",
    "dev:video": "bun scripts/enviar-video.ts",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-pt-br": "^4.1.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
