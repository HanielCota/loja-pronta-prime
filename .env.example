# Copie para .env.local e preencha os valores.
# Estas variáveis são de INFRAESTRUTURA (quem hospeda o sistema configura).
# Configurações de negócio (Hotmart, textos, emails) ficam no painel administrativo.

# Postgres. Em dev, suba com `bun run db:up` (docker-compose.yml).
DATABASE_URL=postgres://lojaprontaprime:lojaprontaprime@localhost:5433/lojaprontaprime

# Chave secreta das sessões (mínimo 32 caracteres). Gere com:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
BETTER_AUTH_SECRET=

# Endereço público do sistema (em produção: https://lojaprontaprime.com).
BETTER_AUTH_URL=http://localhost:3000

# Quantos proxies confiáveis ficam na frente do sistema (padrão: 1, o comum em hospedagem).
# Use 0 se o sistema estiver exposto direto, sem proxy: aí o limite de tentativas por IP é
# desligado (o cabeçalho X-Forwarded-For viria do próprio cliente) e valem só os limites por conta.
# TRUSTED_PROXY_HOPS=1
