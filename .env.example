# Valores fictícios. Substitua antes de usar; nunca envie credenciais pro Git.
# Em desenvolvimento, copie para .env.local. Em produção, configure no Coolify.
# Veja docs/DEPLOY-COOLIFY.md para build, migrações e configurações da hospedagem.

# Porta interna. O Next usa PORT e, sem ela, 3000; não é a porta pública do domínio.
PORT=3000

# Obrigatórias em produção (somente runtime; não precisam entrar no build).
# Use o endereço INTERNO do Postgres, acessível pelo container da aplicação.
DATABASE_URL=postgresql://example_user:example_password@postgres.example.invalid:5432/example_database
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://app.example.invalid

# Número de proxies confiáveis no X-Forwarded-For. 1 só quando existe um proxy.
# Confira a cadeia real; 0 desliga o limite por IP, preservando o limite por conta.
TRUSTED_PROXY_HOPS=1

# Emails de acesso pela Resend. Configure as duas juntas; omita ambas para testar sem envio em dev.
# Chave com permissão de envio, limitada ao domínio verificado. Nunca use NEXT_PUBLIC_ aqui.
RESEND_API_KEY=re_example-not-a-real-api-key
EMAIL_FROM=acesso@mail.example.invalid
# Opcional: endereço de suporte que realmente recebe respostas.
# EMAIL_REPLY_TO=suporte@example.invalid
# Fora de produção: "log" só mostra o link no terminal, sem enviar (os testes e2e já usam).
# EMAIL_DELIVERY=log

# Logos, vídeos e legendas ficam num bucket privado, sem volume de uploads local.
S3_BUCKET=example-bucket
S3_ACCESS_KEY_ID=example-access-key
S3_SECRET_ACCESS_KEY=example-secret-key

# Opcionais. Se não usadas, REMOVA as linhas; valor vazio não é uma chave válida.
# Sem OpenAI, o servidor funciona, mas criar logos por IA fica indisponível e o microfone
# aparece como "em breve". A chave libera gpt-image-1-mini e gpt-transcribe.
OPENAI_API_KEY=example-not-a-real-api-key

# Para S3 compatível: endpoint e região do provedor (não invente esses valores).
# Para AWS S3: omita S3_ENDPOINT e use a região real do bucket.
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Shopee: preencher somente após aprovação e criação do aplicativo.
# Sem as três variáveis válidas, o cliente permanece indisponível.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_TOKEN_ENCRYPTION_KEY= (32 bytes aleatórios, 64 caracteres hexadecimais)

# Piloto Bling da própria empresa (somente administradores). O padrão é desligado.
# Configure os cinco valores juntos no servidor, depois de cadastrar o aplicativo.
# BLING_ENABLED=true
# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=
# BLING_TOKEN_ENCRYPTION_KEY= (32 bytes aleatórios, 64 caracteres hexadecimais)
# BLING_EXPECTED_CNPJ= (14 dígitos do CNPJ da conta piloto, sem pontuação)
